{
  "name": "luau-coder",
  "version": "0.1.0",
  "private": true,
  "author": "Blue965",
  "description": "Luau Coder desktop app and Roblox Studio companion plugin",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --config.directories.output=dist",
    "check": "node --check app/main.js && node --check app/preload.js && node --check app/provider-api.js && node --check app/renderer/app.js && node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.luaucoder.desktop",
    "productName": "Luau Coder",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "artifactName": "Luau-Coder-Setup-${version}.${ext}",
    "win": {
      "icon": "app/renderer/logo.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
